      ],
      "category": "CARGO_REGISTRY",
      "policy": "REPORT_ONLY",
      "label": "Cargo registry 缓存"
    },
    {
      "id": "test-browser-binaries",
      "group": "developer_tool_downloads",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%LOCALAPPDATA%\\ms-playwright",
