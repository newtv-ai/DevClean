      ],
      "category": "TEST_BROWSER_BINARIES",
      "policy": "REPORT_ONLY",
      "label": "测试浏览器下载"
    },
    {
      "id": "android-images",
      "group": "developer_tool_downloads",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%LOCALAPPDATA%\\Android\\Sdk\\system-images"
      ],
      "category": "ANDROID_SDK_PAYLOAD",
      "policy": "REPORT_ONLY",
      "label": "Android SDK 系统镜像"
    },
    {
      "id": "ollama",
      "group": "ai_model_storage",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
