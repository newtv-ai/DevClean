      ],
      "category": "OLLAMA_MODELS",
      "policy": "REPORT_ONLY",
      "label": "Ollama 模型存储"
    },
    {
      "id": "ollama-updates",
      "group": "installer_downloads",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
