    },
    {
      "id": "lmstudio",
      "group": "ai_model_storage",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%USERPROFILE%\\.lmstudio\\models"
      ],
      "category": "LOCAL_MODEL_STORE",
      "policy": "REPORT_ONLY",
      "label": "LM Studio 模型存储"
    },
    {
      "id": "editor-caches",
      "group": "application_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%APPDATA%\\{Code,Code - Insiders,VSCodium,Cursor,Windsurf,Trae,Trae CN,TRAE SOLO,TRAE SOLO CN,Antigravity,Kiro}\\{Cache,CachedData,Code Cache,GPUCache,logs}"
      ],
      "category": "VSCODE_CACHE",
      "policy": "REPORT_ONLY",
