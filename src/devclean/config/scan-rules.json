    },
    {
      "id": "jetbrains-cache",
      "group": "application_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%LOCALAPPDATA%\\JetBrains"
      ],
      "category": "IDE_CACHE",
      "policy": "REPORT_ONLY",
      "label": "JetBrains IDE 缓存"
    },
    {
      "id": "browser-caches",
      "group": "application_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\{Cache,Code Cache,GPUCache}",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\{Cache,Code Cache,GPUCache}",
        "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\{Cache,Code Cache,GPUCache}",
        "%APPDATA%\\Mozilla\\Firefox\\Profiles\\*\\{cache2,startupCache}"
      ],
      "category": "BROWSER_CACHE",
      "policy": "REPORT_ONLY",
