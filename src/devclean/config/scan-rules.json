{
  "schema_version": 3,
  "document_type": "devclean.scan_rules",
  "_help": "DevClean 只从本文件读取扫描范围和已知清理目录。所有路径支持 %环境变量% 和 ~；known_cleanup_roots.patterns 还支持 * 通配符和 {a,b} 组合展开。",
  "_ai_editing_contract": {
    "contract_version": 1,
    "output_format": "FULL_JSON_OBJECT_ONLY",
    "instructions": [
      "返回完整 JSON 对象，不要使用 Markdown 代码块、注释或省略号。",
      "不得修改 schema_version、document_type 或 _ai_editing_contract。",
      "不得增加、删除或改名字段；只修改现有字段的值或数组内容。",
      "review_sample_per_category 是每个处理通道和分类（lane/category）组合最多进入界面和 AI 审核队列的项目数；原始产品规则为 500。",
      "known_cleanup_roots 每项必须保留全部字段，id 必须唯一，group 用于人工分组；delete_root_ids 只能引用其中已有的 id。",
      "不确定的路径不要加入 known_cleanup_roots，先保留原配置。"
    ]
  },
  "include_user_profile": true,
  "include_known_cleanup_roots": true,
  "review_sample_per_category": 500,
  "additional_paths": [],
  "excluded_paths": [],
  "delete_root_ids": [],
  "skip_directory_groups": {
    "version_control": [
      ".git",
      ".hg",
      ".svn"
    ],
    "user_content": [
      "documents",
      "desktop",
      "pictures",
      "music",
      "videos",
      "onedrive",
      "favorites",
      "contacts",
      "links",
      "searches",
      "saved games",
      "3d objects"
    ],
    "credentials": [
      ".ssh",
      ".aws",
      ".azure",
      ".gnupg",
      ".kube"
    ],
    "installed_payload": [
      "program files",
      "program files (x86)",
      "programs",
      "site-packages",
      "windowsapps",
      "assembly",
      "winsxs",
      "servicing",
      "installer"
    ],
    "system_areas": [
      "$recycle.bin",
      "system volume information",
      "config.msi",
      "boot",
      "recovery",
      "perflogs"
    ],
    "devclean_state": [
      "DevClean-data"
    ]
  },
  "known_cleanup_roots": [
    {
      "id": "user-temp",
      "group": "windows_temporary_files",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%TEMP%"
      ],
      "category": "USER_TEMP",
      "policy": "AGE_BASED_REVIEW",
      "label": "当前用户临时文件"
    },
    {
      "id": "windows-temp",
      "group": "windows_temporary_files",
      "enabled": true,
      "allow_inside_system_anchor": true,
      "patterns": [
        "%SYSTEMROOT%\\Temp",
        "%SYSTEMROOT%\\SystemTemp"
      ],
      "category": "USER_TEMP",
      "policy": "AGE_BASED_REVIEW",
      "label": "Windows 临时文件"
    },
    {
      "id": "user-crash-dumps",
      "group": "windows_diagnostics",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%LOCALAPPDATA%\\CrashDumps"
      ],
      "category": "CRASH_DUMPS",
      "policy": "AGE_BASED_REVIEW",
      "label": "当前用户崩溃转储"
    },
    {
      "id": "system-crash-dumps",
      "group": "windows_diagnostics",
      "enabled": true,
      "allow_inside_system_anchor": true,
      "patterns": [
        "%SYSTEMROOT%\\LiveKernelReports",
        "%SYSTEMROOT%\\Minidump",
        "%PROGRAMDATA%\\Microsoft\\Windows\\WER\\ReportQueue",
        "%PROGRAMDATA%\\Microsoft\\Windows\\WER\\ReportArchive",
        "%LOCALAPPDATA%\\Microsoft\\Windows\\WER"
      ],
      "category": "CRASH_DUMPS",
      "policy": "REPORT_ONLY",
      "label": "Windows 错误报告和崩溃转储"
    },
    {
      "id": "windows-maintenance",
      "group": "windows_maintenance",
      "enabled": true,
      "allow_inside_system_anchor": true,
      "patterns": [
        "%SYSTEMROOT%\\Prefetch",
        "%SYSTEMROOT%\\Logs",
        "%SYSTEMROOT%\\CbsTemp"
      ],
      "category": "SYSTEM_LOGS",
      "policy": "REPORT_ONLY",
      "label": "Windows 可重建维护数据"
    },
    {
      "id": "windows-update-downloads",
      "group": "windows_update",
      "enabled": true,
      "allow_inside_system_anchor": true,
      "patterns": [
        "%SYSTEMROOT%\\SoftwareDistribution\\Download"
      ],
      "category": "WINDOWS_UPDATE",
      "policy": "REPORT_ONLY",
      "label": "Windows 更新下载"
    },
    {
      "id": "windows-old",
      "group": "windows_update",
      "enabled": true,
      "allow_inside_system_anchor": true,
      "patterns": [
        "%SYSTEMDRIVE%\\Windows.old"
      ],
      "category": "WINDOWS_UPDATE",
      "policy": "REPORT_ONLY",
      "label": "Windows 旧系统目录"
    },
    {
      "id": "windows-internet-cache",
      "group": "windows_application_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache"
      ],
      "category": "BROWSER_CACHE",
      "policy": "REPORT_ONLY",
      "label": "Windows Internet 临时文件"
    },
    {
      "id": "thumbnail-cache",
      "group": "windows_application_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer"
      ],
      "category": "THUMBNAIL_CACHE",
      "policy": "REPORT_ONLY",
      "label": "Windows 缩略图与图标缓存"
    },
    {
      "id": "pip-cache",
      "group": "package_manager_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%PIP_CACHE_DIR%",
        "%LOCALAPPDATA%\\pip\\Cache",
        "%APPDATA%\\pip\\Cache",
        "%LOCALAPPDATA%\\pip-tools\\Cache"
      ],
      "category": "PIP_CACHE",
      "policy": "REPORT_ONLY",
      "label": "Python 包缓存"
    },
    {
      "id": "uv-cache",
      "group": "package_manager_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%UV_CACHE_DIR%",
        "%LOCALAPPDATA%\\uv\\cache"
      ],
      "category": "UV_CACHE",
      "policy": "REPORT_ONLY",
      "label": "uv 包缓存"
    },
    {
      "id": "npm-cache",
      "group": "package_manager_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%NPM_CONFIG_CACHE%",
        "%LOCALAPPDATA%\\npm-cache",
        "%APPDATA%\\npm-cache"
      ],
      "category": "NPM_CACHE",
      "policy": "REPORT_ONLY",
      "label": "npm 包缓存"
    },
    {
      "id": "pnpm-store",
      "group": "package_manager_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%PNPM_HOME%\\store",
        "%LOCALAPPDATA%\\pnpm\\store"
      ],
      "category": "PNPM_STORE",
      "policy": "REPORT_ONLY",
      "label": "pnpm 包存储"
    },
    {
      "id": "conda-cache",
      "group": "package_manager_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%USERPROFILE%\\.conda\\pkgs",
        "%USERPROFILE%\\miniconda3\\pkgs",
        "%USERPROFILE%\\anaconda3\\pkgs"
      ],
      "category": "CONDA_CACHE",
      "policy": "REPORT_ONLY",
      "label": "Conda 包缓存"
    },
    {
      "id": "huggingface-cache",
      "group": "ai_model_storage",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%HF_HOME%",
        "%HF_HUB_CACHE%",
