    },
    {
      "id": "ide-working-caches",
      "group": "application_cache",
      "enabled": true,
      "allow_inside_system_anchor": false,
      "patterns": [
        "%LOCALAPPDATA%\\skylot",
        "%LOCALAPPDATA%\\Microsoft\\TypeScript",
        "%LOCALAPPDATA%\\.dartServer"
      ],
      "category": "IDE_CACHE",
      "policy": "REPORT_ONLY",
